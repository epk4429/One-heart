{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "{data/assumptions.json,data/presets/*.json,ontology/*.json}"
    }
  },
  "outputDirectory": "web"
}