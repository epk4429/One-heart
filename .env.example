# 저장소에 올리는 예시 파일. 실제 값은 .env에(올리지 않음).
# 공급자: anthropic(시나리오 통합 테스트·시연) | hf(오픈소스, 개발용) | replay(재생, 실제 LLM 아님)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
# 생각 깊이를 모든 역할에 같게 하려면 low|medium|high. 비우면 역할마다 정한 값(쉬운 정리 low, 설계·해석 medium)
LLM_EFFORT=
ANTHROPIC_API_KEY=
HF_TOKEN=
ALLOWED_ORIGIN=

# 체험 보호(api/guard.py). ACCESS_CODES가 비어 있으면 코드 없이 쓸 수 있다(로컬 개발).
# 예: ACCESS_CODES=judge2026:2.0,friend:0.5  (콜론 뒤는 그 코드로 쓸 수 있는 AI 비용, 달러)
ACCESS_CODES=
# 모든 AI 호출(로컬 평가 포함)의 비용 합계 상한(달러). 넘으면 AI 호출을 막는다.
BUDGET_USD=6.0
RATE_PER_MIN=20
